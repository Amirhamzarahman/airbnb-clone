<%- include('../partials/head') %>

</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <div class="mx-auto max-w-4xl px-6 py-10">
   <%- include('../partials/header') %>
     <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
          <h2 class="text-3xl text-gray-800 font-bold text-center mb-6">
              Details of <%= home.houseName %>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="rounded-lg overflow-hidden">
                  <img src="<%= home.houseUrl %>" alt="<%= home.name %>" class="w-full h-96 object-cover">
              </div>
              
              <div class="space-y-6">
                  

                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Location</h3>
                      <p class="text-gray-600"><%= home.houseLocation %></p>
                  </div>
                  
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Price</h3>
                      <p class="text-green-600 text-xl font-bold">$<%= home.housePrice %> / night</p>
                  </div>
                  
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Rating</h3>
                      <div class="flex items-center">
                          <span class="text-yellow-400 text-xl">★</span>
                          <span class="ml-2 text-lg"><%= home.houseRating %> / 5</span>
                      </div>
                  </div>
                  <div>

                    <form action="/user/favourites" class="mt-6" method="POST">
                          <button type="submit" class="w-full rounded-full bg-slate-900 px-6 py-3 text-white font-semibold hover:bg-slate-700 transition-colors duration-200">
                              Add to Favorite
                          </button>
                          <input type="hidden" name="id" value="<%= home._id %>">
                      </form>
                    
    

                  </div>
                
              </div>
          </div>
        </main>
  </div>
</body>
</html>