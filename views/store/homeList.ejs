<%- include('../partials/head') %>

</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <div class="mx-auto max-w-4xl px-6 py-10">
   <%- include('../partials/header') %>
    <main class="space-y-8">
      <div>
          <h1 class="text-4xl font-semibold text-slate-900">Welcome to Air Bnb home List Page</h1>
          <p class="mt-3 text-slate-600">Browse registered homes or add your own listing.</p>
        </div>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-xl font-semibold text-slate-800">Here are our registered homes are : <%- registeredHomes.length %></h2>
      </div>

      <ul class="flex flex-col gap-4">
        <% registeredHomes.forEach((home) => { %>
          <li class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="mb-6 overflow-hidden rounded-3xl bg-slate-100">
              <img src="<%= home.houseUrl %>" alt="<%= home.houseName %>" class="h-64 w-full object-cover object-center transition duration-200 hover:scale-105" />
            </div>
            <div class="flex items-center justify-between gap-4">
              <div>
                <h3 class="text-lg font-semibold text-slate-900"><%= home.houseName %></h3>
                <p class="mt-2 text-sm text-slate-600">Location: <span class="font-medium text-slate-800"><%= home.houseLocation %></span></p>
                <p class="mt-1 text-sm text-slate-600">Ratings: <span class="font-medium text-slate-800"><%= home.houseRating %></span></p>
              </div>
              <div class="rounded-2xl bg-slate-100 px-4 py-3 text-right">
                <p class="text-sm text-slate-500">House Rate</p>
                <p class="text-xl font-semibold text-slate-900"><%= home.housePrice %>₹</p>
              </div>
              <a class=" cursor-pointer rounded-2xl bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-sky-200 transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2" href="/user/homes/<%= home._id %>">View Details</a>
              
              <div class="mt-[-24px]">
              <%- include('../partials/favourites', {home}) %>
              </div>

            </div>
          </li>
        <% }) %>
      </ul>
      
    </main>
  </div>
</body>
</html>