<%- include('../partials/head') %>
</head>
<body>
 <%- include('../partials/header') %>
    
  <main>
    <div>
          <h1 class="text-4xl font-semibold text-slate-900"><%= editing ? "Edit " : "Add " %>Your home here</h1>
        </div>
    <form action="/host/<%= editing? "edit-home": "add-home"%>" method="POST" class="space-y-4">
      <input type="hidden" name="id" value="<%= editing? home._id: '' %>">
      <input 
        type="text"
        placeholder="Enter the name of your home"
        value="<%= editing? home.houseName  : "" %>"
        name="houseName"
        class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
      />
      <input
        type="text"
        placeholder="Enter the image url which will be '/images/house1/2/3...8 images in total.png' "
        value="<%= editing? home.houseUrl: "" %>"
        name="houseUrl"
        class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
      />
      <input
        type="number"
        placeholder="Enter the rate per night"
        value="<%= editing? home.housePrice : "" %>"
        name="housePrice"
        step="0.01"
        class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
      />
      <input
        type="text"
        placeholder="Enter the location"
        value="<%= editing? home.houseLocation : "" %>"
        name="houseLocation"
        class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
      />
      <input
        type="number"
        value="<%= editing? home.houseRating : "" %>"
        placeholder="Enter the rating"
        name="houseRating"
        step="0.1"
        min="0"
        max="5"
        class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
      />
      <input
        type="submit"
        value="<%= editing? "Update": "Add Home" %>"
        class="inline-flex w-full justify-center rounded-2xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-sky-200 transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2"
      />
    </form>
  </main>
  
</body>
</html>